# Apply supabase/migrations/001_bountex.sql before enabling live mode.
SUPABASE_URL=
# Modern Supabase server key; never use a VITE_ prefix for secrets.
SUPABASE_SECRET_KEY=
# Optional legacy service-role JWT instead of the modern secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional local setup token for applying SQL through the Management API.
# Keep it server-side and omit it from application deployments.
SUPABASE_ACCESS_TOKEN=
APP_ORIGIN=http://127.0.0.1:5175
NIMIQ_RPC_URL=
# Optional Basic authentication for your RPC. Server-side only.
NIMIQ_RPC_USERNAME=
NIMIQ_RPC_PASSWORD=
NIMIQ_NETWORK=testnet
API_PORT=4174
